        "finale": {
          "rate": 1.12,
          "mainVol": 0.6,
          "tensionVol": 0.45,
          "rampSec": 0.5,
          "when": "퇴근 피날레(17:48~) 기본 단계. 위 조건이 더 높으면 danger"
        },
        "freeze": {
          "stop": true,
          "fadeOutSec": 0.08,
          "resume": "pause_position",
          "resumeFadeInSec": 0.6,
          "resumeStage": "calm",
          "when": "대표님 순시 전조(bgm: stop, sfx_elevator_ding과 같은 프레임) ~ 퇴장 후 하위 상사 복귀(1.0초 뒤)"
        },
        "stopped": {
          "stop": true,
          "fadeOutSec": 0.0,
          "when": "적발 컷인(sfx_caught) / 퇴근 성공(0.2초 페이드 후 sfx_clockout_fanfare)"
