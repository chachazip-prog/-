          "sfx": "sfx_footstep_stop"
        },
        "doubleLook": {
          "chance": 0.0,
          "capChance": 0.0
        }
      },
      "visit": {
        "patrolId": "p_ceo_visit",
        "spawnRequires": "player_seated",
        "freeze": {
          "global": true,
          "untilStop": "stop_ceo_greet",
          "maxSec": 5.0,
          "safetyExtraSec": 3.0,
          "_safetyNote": "T-136 확정(개발 해석 승인): 대표님이 maxSec + safetyExtraSec(8초) 안에 stop_ceo_greet에 못 오면(얼어 있는 캐릭터가 길을 막는 등 경로 지연) 그 자리에서 인사 QTE를 강제로 시작. 정상 입장은 4.6초라 평소에는 작동하지 않음. 3초 = 길막 대기(movement.blockedWaitSec 0.5) + 우회 재탐색(rerouteRecheckSec 0.5) + 우회로 +4타일 ÷ 2.4 ≈ 1.7초의 합 2.7초 + 여유. 얼음 중 앉아 있으면 의심이 오르지 않으므로 길어져도 억울한 실패는 없음. 🧪 QA: 얼음 구간 길이 분포에서 5초 초과 비율 < 1%, 8초 도달 0(경로가 정상일 때)",
